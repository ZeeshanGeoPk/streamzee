<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline_media/" />
        <exclude domain="file" path="music_stream_cache/" />
        <exclude domain="external" path="Music/" />
        <exclude domain="sharedpref" path="music_downloads.xml" />
        <exclude domain="database" path="exoplayer_internal.db" />
        <exclude domain="sharedpref" path="streamzee_downloads.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline_media/" />
        <exclude domain="file" path="music_stream_cache/" />
        <exclude domain="external" path="Music/" />
        <exclude domain="sharedpref" path="music_downloads.xml" />
        <exclude domain="database" path="exoplayer_internal.db" />
        <exclude domain="sharedpref" path="streamzee_downloads.xml" />
    </device-transfer>
</data-extraction-rules>
