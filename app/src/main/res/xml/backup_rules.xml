<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="file" path="offline_media/" />
        <exclude domain="file" path="music_stream_cache/" />
        <exclude domain="external" path="Music/" />
        <exclude domain="sharedpref" path="music_downloads.xml" />
    <exclude domain="database" path="exoplayer_internal.db" />
    <exclude domain="sharedpref" path="streamzee_downloads.xml" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
